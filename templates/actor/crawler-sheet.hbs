<div class="crawl-sheet-body">
<header class="crawl-head">
  <img class="crawl-portrait" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}">
  <div class="crawl-ident">
    <input class="crawl-name" type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
    <div class="crawl-ident-row">
      <label>Level <input type="number" name="system.level" value="{{system.level}}" min="1" {{#unless editable}}disabled{{/unless}}></label>
      <label>Floor <input type="number" name="system.floor" value="{{system.floor}}" min="1" title="Current World Dungeon floor — feeds Evade and other Difficulty formulas" {{#unless editable}}disabled{{/unless}}></label>
      <label>Race <input type="text" name="system.details.race" value="{{system.details.race}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Class <input type="text" name="system.details.className" value="{{system.details.className}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <div class="crawl-ident-row">
      <label>Background <input type="text" name="system.details.background" value="{{system.details.background}}" {{#unless editable}}disabled{{/unless}}></label>
      <label>Sponsor <input type="text" name="system.details.sponsor" value="{{system.details.sponsor}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
  </div>
</header>

<nav class="crawl-tabs">
  {{#each tabs}}
  <button type="button" class="crawl-tab-btn {{#if (crEq this.id ../tab)}}active{{/if}}" data-action="showTab" data-tab="{{this.id}}">{{this.label}}</button>
  {{/each}}
</nav>

<section class="crawl-body">

  {{#if (crEq tab "character")}}
  <div class="crawl-vitals">
    <div class="crawl-bar crawl-bar-hp">
      <span class="crawl-bar-label">Health Bar</span>
      <div class="crawl-hp-slots">
        {{#each hpSlots}}
        <span class="crawl-hp-slot {{#if this.filled}}filled{{/if}} {{#if this.temp}}temp{{/if}}"></span>
        {{/each}}
      </div>
      <div class="crawl-bar-values">
        <input type="number" name="system.hp.filledSlots" value="{{system.hp.filledSlots}}" min="0" max="10" title="Filled slots" {{#unless editable}}disabled{{/unless}}>
        <span>/ 10 slots ({{system.hp.slotValue}} ea.)</span>
      </div>
    </div>

    {{#if editable}}
    <div class="crawl-injury-buttons">
      <button type="button" data-action="applyInjury" data-severity="minor" title="Apply a -2 penalty to all Checks">Minor Injury</button>
      <button type="button" data-action="applyInjury" data-severity="major" title="Apply a -5 penalty to all Checks">Major Injury</button>
    </div>
    {{/if}}

    <div class="crawl-bar crawl-bar-mana">
      <span class="crawl-bar-label">Mana</span>
      <div class="crawl-bar-track"><div class="crawl-bar-fill" style="width: {{manaPct}}%"></div></div>
      <div class="crawl-bar-values">
        <input type="number" name="system.mana.value" value="{{system.mana.value}}" {{#unless editable}}disabled{{/unless}}>
        <span>/ {{system.mana.max}}</span>
      </div>
    </div>

    <div class="crawl-stat-grid crawl-stat-grid-3">
      <div class="crawl-stat">
        <span>Evade <span class="crawl-hint-icon" title="{{system.evade.value}} is the passive value Mobs roll against (GMs don't roll defense). Your own defense is an active 1d20 + DEX mod roll, either via the Evade button in chat when attacked, or click this number to roll it manually.">?</span></span>
        <button type="button" class="crawl-stat-roll" data-action="rollEvadeCheck" title="Roll Evade (Shift = Advantage, Ctrl = Disadvantage)"><strong>{{system.evade.value}}</strong></button>
      </div>
      <div class="crawl-stat"><span>Damage Resistance</span><strong>{{system.damageResistance.value}}</strong></div>
      <div class="crawl-stat"><span>Gold</span>
        <input type="number" name="system.gold" value="{{system.gold}}" {{#unless editable}}disabled{{/unless}}></div>
    </div>

    <div class="crawl-stat-grid crawl-stat-grid-3">
      <div class="crawl-stat"><span>Move</span>
        <input type="number" name="system.move" value="{{system.move}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="crawl-stat"><span>Step</span>
        <input type="number" name="system.step" value="{{system.step}}" {{#unless editable}}disabled{{/unless}}></div>
      <div class="crawl-stat"><span>Size</span>
        <select name="system.size" {{#unless editable}}disabled{{/unless}}>
          {{crOptions sizes system.size}}
        </select>
      </div>
    </div>
  </div>

  <div class="crawl-attributes">
    {{#each attributes}}
    <div class="crawl-attr">
      <button type="button" class="crawl-attr-roll" data-action="rollAttribute" data-key="{{this.key}}" title="Roll {{this.label}} (Shift = Advantage, Ctrl = Disadvantage)">
        <span class="crawl-attr-abbr">{{this.abbr}}</span>
        <span class="crawl-attr-total">{{crSign this.mod}}</span>
        <span class="crawl-attr-score">{{this.total}}</span>
      </button>
      <div class="crawl-attr-inputs">
        <input type="number" name="system.attributes.{{this.key}}.value" value="{{this.value}}" min="0" title="Base score" {{#unless ../editable}}disabled{{/unless}}>
        <input type="number" name="system.attributes.{{this.key}}.bonus" value="{{this.bonus}}" title="Bonus from race, class, elixirs" {{#unless ../editable}}disabled{{/unless}}>
      </div>
      <span class="crawl-attr-label">{{this.label}}</span>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if (crEq tab "skills")}}
  <h3 class="crawl-subhead">Attacks</h3>
  <ol class="crawl-list">
    {{#each attackSkills}}
    <li class="crawl-row crawl-row-gear draggable" data-item-id="{{this.id}}">
      <button type="button" class="crawl-row-name" data-action="rollSkill" title="Attack with {{this.name}} (Shift = Advantage, Ctrl = Disadvantage)" {{#if this.cooldownRemaining}}disabled{{/if}}>{{this.name}}</button>
      <span class="crawl-mono">{{this.damage}} + {{crUpper this.attribute}}</span>
      <span class="crawl-muted">
        {{this.attackTypeLabel}}{{#if this.range}} · {{this.range}}{{/if}}{{#if this.damageTypeLabel}} · {{this.damageTypeLabel}}{{/if}}
        {{#if this.cooldownRemaining}} · Cooldown {{this.cooldownRemaining}}{{/if}}
        {{#if this.boosts.length}}
        <select data-boost class="crawl-boost-select">
          <option value="">No boost</option>
          {{#each this.boosts}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
        {{/if}}
      </span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        <button type="button" data-action="{{#if this.pinned}}unpinItem{{else}}pinItem{{/if}}" title="{{#if this.pinned}}Unpin{{else}}Pin to Hotlist{{/if}}">
          <i class="fa-solid fa-star{{#unless this.pinned}}-half-stroke{{/unless}}"></i>
        </button>
        {{/if}}
        <button type="button" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
      </span>
    </li>
    {{else}}
    <li class="crawl-empty">No Attack Skills yet.</li>
    {{/each}}
  </ol>
  <div class="crawl-list-foot">
    <button type="button" data-action="createItem" data-type="skill" data-skill-type="attack" data-label="Attack Skill">New Attack Skill</button>
  </div>

  <h3 class="crawl-subhead">Spells</h3>
  <ol class="crawl-list">
    {{#each spellSkills}}
    <li class="crawl-row crawl-row-gear draggable" data-item-id="{{this.id}}">
      <button type="button" class="crawl-row-name" data-action="rollSkill" title="Cast {{this.name}} (Shift = Advantage, Ctrl = Disadvantage)" {{#if this.cooldownRemaining}}disabled{{/if}}>{{this.name}}</button>
      <span class="crawl-mono">{{this.damage}} + {{crUpper this.attribute}}</span>
      <span class="crawl-muted">
        {{this.manaCost}} Mana{{#if this.range}} · {{this.range}}{{/if}}{{#if this.damageTypeLabel}} · {{this.damageTypeLabel}}{{/if}}
        {{#if this.cooldownRemaining}} · Cooldown {{this.cooldownRemaining}}{{/if}}
        {{#if this.boosts.length}}
        <select data-boost class="crawl-boost-select">
          <option value="">No boost</option>
          {{#each this.boosts}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
        {{/if}}
      </span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        <button type="button" data-action="{{#if this.pinned}}unpinItem{{else}}pinItem{{/if}}" title="{{#if this.pinned}}Unpin{{else}}Pin to Hotlist{{/if}}">
          <i class="fa-solid fa-star{{#unless this.pinned}}-half-stroke{{/unless}}"></i>
        </button>
        {{/if}}
        <button type="button" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
      </span>
    </li>
    {{else}}
    <li class="crawl-empty">No Spells yet.</li>
    {{/each}}
  </ol>
  <div class="crawl-list-foot">
    <button type="button" data-action="createItem" data-type="skill" data-skill-type="spell" data-label="Spell">New Spell</button>
  </div>

  <h3 class="crawl-subhead">Utility</h3>
  <div class="crawl-list-head crawl-row-skill">
    <span>Skill</span><span>Attr</span><span>Rank</span><span>Floor</span><span>Total</span><span></span>
  </div>
  <ol class="crawl-list">
    {{#each utilitySkills}}
    <li class="crawl-row crawl-row-skill draggable" data-item-id="{{this.id}}">
      <span class="crawl-row-name-wrap">
        <button type="button" class="crawl-row-name" data-action="rollSkill" title="{{#if this.rollable}}Roll {{this.name}} (Shift = Advantage, Ctrl = Disadvantage){{else}}Post {{this.name}}'s description to chat{{/if}}">{{this.name}}</button>
        <span class="crawl-check-badge">{{this.checkTypeLabel}}{{#unless (crEq this.buffScope "none")}} · Buff{{/unless}}</span>
      </span>
      <span class="crawl-mono">{{crUpper this.attribute}}</span>
      <span class="crawl-rank">
        <button type="button" data-action="adjustRank" data-delta="-1" {{#unless ../editable}}disabled{{/unless}}>−</button>
        <span class="crawl-mono">{{this.rank}}</span>
        <button type="button" data-action="adjustRank" data-delta="1" {{#unless ../editable}}disabled{{/unless}}>+</button>
      </span>
      <input class="crawl-mono crawl-tiny" type="number" data-item-id="{{this.id}}" data-field="system.floorBonus" data-dtype="Number" value="{{this.floorBonus}}" title="Temporary situational bonus" {{#unless ../editable}}disabled{{/unless}}>
      <span class="crawl-mono crawl-total">{{crSign this.total}}</span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        <button type="button" data-action="{{#if this.pinned}}unpinItem{{else}}pinItem{{/if}}" title="{{#if this.pinned}}Unpin{{else}}Pin to Hotlist{{/if}}">
          <i class="fa-solid fa-star{{#unless this.pinned}}-half-stroke{{/unless}}"></i>
        </button>
        {{/if}}
        <button type="button" data-action="editItem" title="Edit"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="deleteItem" title="Delete"><i class="fa-solid fa-trash"></i></button>
      </span>
    </li>
    {{else}}
    <li class="crawl-empty">No Utility Skills yet.</li>
    {{/each}}
  </ol>
  <div class="crawl-list-foot">
    <button type="button" data-action="createItem" data-type="skill" data-skill-type="utility" data-label="Utility Skill">New Utility Skill</button>
  </div>

  <h3 class="crawl-subhead">Features</h3>
  <ol class="crawl-list">
    {{#each features}}
    <li class="crawl-row crawl-row-ability draggable" data-item-id="{{this.id}}">
      <button type="button" class="crawl-row-name" data-action="rollSkill" title="Post {{this.name}}'s description to chat">{{this.name}}</button>
      <span class="crawl-kind">{{this.kindLabel}}</span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        <button type="button" data-action="{{#if this.pinned}}unpinItem{{else}}pinItem{{/if}}" title="{{#if this.pinned}}Unpin{{else}}Pin to Hotlist{{/if}}">
          <i class="fa-solid fa-star{{#unless this.pinned}}-half-stroke{{/unless}}"></i>
        </button>
        {{/if}}
        <button type="button" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
      </span>
    </li>
    {{else}}
    <li class="crawl-empty">No class abilities, racial traits, achievements or sponsorships yet.</li>
    {{/each}}
  </ol>
  <div class="crawl-list-foot">
    <button type="button" data-action="createItem" data-type="skill" data-skill-type="feature" data-label="Feature">New Feature</button>
  </div>
  {{/if}}

  {{#if (crEq tab "gear")}}
  <h3 class="crawl-subhead">Gear Slots</h3>
  <div class="crawl-gear-slots">
    {{#each gearSlots}}
    <div class="crawl-gear-slot">
      <span class="crawl-gear-slot-label">{{this.label}}</span>
      <span class="crawl-gear-slot-item">{{#if this.item}}{{this.item.name}}{{else}}—{{/if}}</span>
    </div>
    {{/each}}
    <div class="crawl-gear-slot">
      <span class="crawl-gear-slot-label">Accessories ({{accessories.length}}/10)</span>
      <span class="crawl-gear-slot-item">
        {{#each accessories}}{{this.name}}{{#unless @last}}, {{/unless}}{{else}}—{{/each}}
      </span>
    </div>
  </div>

  <h3 class="crawl-subhead">Weapons</h3>
  <ol class="crawl-list">
    {{#each weapons}}
    <li class="crawl-row crawl-row-gear draggable" data-item-id="{{this.id}}">
      <button type="button" class="crawl-row-name" data-action="rollAttackGear" title="Attack with {{this.name}} (Shift = Advantage, Ctrl = Disadvantage)" {{#unless this.linkedSkillId}}disabled{{/unless}}>{{this.name}}</button>
      <span class="crawl-mono">{{#if this.linkedSkillDamage}}{{this.linkedSkillDamage}}{{else}}—{{/if}}</span>
      <span class="crawl-muted">{{#if this.skill}}Skill: {{this.skill}}{{else}}No linked Skill{{/if}}</span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        <button type="button" data-action="toggleEquip" title="{{#if this.equipped}}Unequip{{else}}Equip{{/if}}">
          <i class="fa-solid {{#if this.equipped}}fa-hand-fist{{else}}fa-hand{{/if}}"></i>
        </button>
        <button type="button" data-action="{{#if this.pinned}}unpinItem{{else}}pinItem{{/if}}" title="{{#if this.pinned}}Unpin{{else}}Pin to Hotlist{{/if}}">
          <i class="fa-solid fa-star{{#unless this.pinned}}-half-stroke{{/unless}}"></i>
        </button>
        {{/if}}
        <button type="button" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
      </span>
    </li>
    {{/each}}
  </ol>

  <h3 class="crawl-subhead">Carried</h3>
  <ol class="crawl-list">
    {{#each otherGear}}
    <li class="crawl-row crawl-row-gear draggable" data-item-id="{{this.id}}">
      <span class="crawl-row-name">{{this.name}}</span>
      <span class="crawl-mono">×{{this.quantity}}</span>
      <span class="crawl-muted">{{this.kindLabel}}</span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        {{#if (crEq this.kind "consumable")}}
        <button type="button" data-action="useItem" title="Use">
          <i class="fa-solid fa-flask"></i>
        </button>
        {{/if}}
        {{#unless (crEq this.slot "none")}}
        <button type="button" data-action="toggleEquip" title="{{#if this.equipped}}Unequip{{else}}Equip{{/if}}">
          <i class="fa-solid {{#if this.equipped}}fa-shield-halved{{else}}fa-shield{{/if}}"></i>
        </button>
        {{/unless}}
        <button type="button" data-action="{{#if this.pinned}}unpinItem{{else}}pinItem{{/if}}" title="{{#if this.pinned}}Unpin{{else}}Pin to Hotlist{{/if}}">
          <i class="fa-solid fa-star{{#unless this.pinned}}-half-stroke{{/unless}}"></i>
        </button>
        {{/if}}
        <button type="button" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
        <button type="button" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
      </span>
    </li>
    {{else}}
    <li class="crawl-empty">Nothing but the pyjamas you died in.</li>
    {{/each}}
  </ol>
  <div class="crawl-list-foot">
    <button type="button" data-action="createItem" data-type="gear">New gear</button>
  </div>
  {{/if}}

  {{#if (crEq tab "hotlist")}}
  <ol class="crawl-list">
    {{#each hotlist}}
    <li class="crawl-row crawl-row-hotlist draggable" data-item-id="{{this.id}}">
      <img class="crawl-hotlist-icon" src="{{this.img}}" alt="{{this.name}}">
      <button type="button" class="crawl-row-name" data-action="rollHotlist" title="Roll {{this.name}}">{{this.name}}</button>
      <span class="crawl-muted">{{this.sub}}</span>
      <span class="crawl-row-controls">
        {{#if ../editable}}
        <button type="button" data-action="unpinItem" title="Unpin"><i class="fa-solid fa-star"></i></button>
        {{/if}}
      </span>
    </li>
    {{else}}
    <li class="crawl-empty">Nothing pinned yet. Use the star icon on a skill, weapon or spell to add it here.</li>
    {{/each}}
  </ol>
  {{/if}}

  {{#if (crEq tab "effects")}}
  {{> "systems/crawler-d20/templates/partials/effects-list.hbs" effects=effects editable=editable}}
  {{/if}}

  {{#if (crEq tab "notes")}}
  <div class="crawl-notes">
    <label class="crawl-notes-label">Who were you before the world ended?</label>
    {{> "systems/crawler-d20/templates/partials/richtext.hbs"
      field="biography" path="system.details.biography" rows=14 editable=editable
      editing=editing.biography rendered=rendered.biography raw=system.details.biography}}
  </div>
  {{/if}}

  {{#if (crEq tab "gm")}}
  <div class="crawl-notes crawl-gm-notes">
    <label class="crawl-notes-label">Visible to the GM only</label>
    {{> "systems/crawler-d20/templates/partials/richtext.hbs"
      field="gmNotes" path="system.gmNotes" rows=14 editable=editable
      editing=editing.gmNotes rendered=rendered.gmNotes raw=system.gmNotes}}
  </div>
  {{/if}}

</section>
</div>
